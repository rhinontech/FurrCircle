{
  "expo": {
    "name": "FurrCircle",
    "slug": "furrcircle-expo",
    "version": "1.0.0",
    "scheme": "furrcircle",
    "orientation": "portrait",
    "icon": "./assets/furrCircle_IOS_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/furrCircle_splash_screen1.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.furrcircle.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "splash": {
        "image": "./assets/adaptive-icon.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/furrCircle_android_icon2.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.furrcircle.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FurrCircle to access your photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FurrCircle to use your location to find nearby matches and vets.",
          "locationWhenInUsePermission": "Allow FurrCircle to use your location to find nearby matches and vets."
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/auth",
        {
          "ios": {
            "captchaOpenUrlFix": false
          }
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}